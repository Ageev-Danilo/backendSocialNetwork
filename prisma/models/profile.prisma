model Profile {
  id           Int     @id @default(autoincrement())
  pseudonym    String  @unique
  firstName    String
  lastName     String
  date         String  // ← було DateTime, стало String
  username     String  @unique
  signature    String?
  profileImage String?

  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}